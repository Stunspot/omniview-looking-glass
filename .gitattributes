# CD line-ending policy: LF for authored text; explicit exceptions below.
* text=auto eol=lf

# Windows-native text exceptions.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary containers and media.
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary

# Preserve frozen release artifact bytes.
release/** -text

# Accepted estate r8 source and companions retain reviewed bytes.
maintenance-candidates/* -text
plugins/omniview-looking-glass/** -text
dist/claude-code/omniview-looking-glass/** -text
